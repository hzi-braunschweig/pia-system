/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": "./",
    "outDir": "./dist/out-tsc",
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "strict": true,
    "strictFunctionTypes": false, // set to true if possible
    "useUnknownInCatchVariables": false, // set to true if possible
    "noImplicitAny": false, // set to true if possible
    "strictNullChecks": false, // set to true if possible
    "strictPropertyInitialization": false, // set to true if possible - depends on strictNullChecks
    "noPropertyAccessFromIndexSignature": false,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": false, // set to true if possible
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "sourceMap": true,
    "declaration": false,
    "experimentalDecorators": true,
    "moduleResolution": "node",
    "importHelpers": true,
    "target": "ES2022",
    "module": "es2020",
    "lib": ["ESNext", "dom", "dom.iterable"],
    "paths": {
      "swiper_angular": ["node_modules/swiper/angular"]
    },
    "useDefineForClassFields": false
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  },
  "exclude": ["cypress", "cypress.config.ts"]
}
