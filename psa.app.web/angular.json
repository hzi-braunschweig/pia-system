{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "psa": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        },
        "@schematics/angular:application": {
          "strict": true
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": {
              "base": "dist"
            },
            "index": "src/index.html",
            "polyfills": ["src/polyfills.ts"],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "preserveSymlinks": true,
            "allowedCommonJsDependencies": [
              "base64-js",
              "jspdf",
              "jspdf-autotable",
              "js-sha256",
              "keycloak-js",
              "luxon",
              "remove-markdown"
            ],
            "assets": [
              "src/favicon.png",
              "src/assets",
              "src/firebase-messaging-sw.js"
            ],
            "styles": [
              "src/custom-theme.scss",
              "src/styles.scss",
              "./node_modules/flag-icon-css/css/flag-icons.min.css",
              "./node_modules/swiper/swiper-bundle.css",
              "./node_modules/material-design-icons-iconfont/dist/material-design-icons.css"
            ],
            "stylePreprocessorOptions": {
              "includePaths": ["src"]
            },
            "scripts": ["./node_modules/marked/marked.min.js"],
            "browser": "src/main.ts"
          },
          "configurations": {
            "production-admin-app": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.admin.prod.ts"
                }
              ],
              "outputHashing": "all",
              "baseHref": "/admin/",
              "outputPath": {
                "base": "./dist/out/admin"
              }
            },
            "development-admin-app": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.admin.ts"
                }
              ],
              "outputHashing": "media",
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true,
              "baseHref": "/admin/",
              "outputPath": {
                "base": "./dist/admin"
              }
            }
          },
          "defaultConfiguration": "throw-on-default"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production-admin-app": {
              "buildTarget": "psa:build:production-admin-app"
            },
            "development-admin-app": {
              "proxyConfig": "proxy.conf.json",
              "buildTarget": "psa:build:development-admin-app"
            }
          },
          "defaultConfiguration": "throw-on-default"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "psa:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "preserveSymlinks": true,
            "codeCoverage": true,
            "main": "src/test.ts",
            "polyfills": "src/polyfills.ts",
            "tsConfig": "tsconfig.spec.json",
            "karmaConfig": "karma.conf.js",
            "inlineStyleLanguage": "scss",
            "assets": ["src/favicon.ico", "src/assets"],
            "styles": ["src/styles.scss"],
            "stylePreprocessorOptions": {
              "includePaths": ["src"]
            },
            "scripts": []
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["src/**/*.ts", "src/**/*.html"]
          }
        },
        "cypress-run": {
          "builder": "@cypress/schematic:cypress",
          "options": {
            "devServerTarget": "psa:serve"
          },
          "configurations": {
            "production-admin-app": {
              "devServerTarget": "psa:serve:production-admin-app"
            }
          }
        },
        "cypress-open": {
          "builder": "@cypress/schematic:cypress",
          "options": {
            "devServerTarget": "psa:serve",
            "watch": true,
            "headless": false
          },
          "configurations": {
            "production-admin-app": {
              "devServerTarget": "psa:serve:production-admin-app"
            }
          }
        },
        "e2e": {
          "builder": "@cypress/schematic:cypress",
          "options": {
            "devServerTarget": "psa:serve",
            "watch": true,
            "headless": false
          },
          "configurations": {
            "production-admin-app": {
              "devServerTarget": "psa:serve:production-admin-app"
            }
          }
        }
      }
    }
  },
  "cli": {
    "schematicCollections": ["@angular-eslint/schematics"],
    "analytics": false
  }
}
