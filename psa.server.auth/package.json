{
  "name": "psa.server.auth",
  "version": "1.6.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "styles:build": "npm run styles:build:login",
    "styles:build:login": "sass --no-source-map themes/pia/login/resources/scss/styles.scss:themes/pia/login/resources/css/styles.css",
    "styles:cleanup": "rm -rf themes/pia/login/resources/css",
    "styles:postcss": "postcss themes/pia/login/resources/css/styles.css --replace",
    "theme:build": "npm run styles:cleanup && npm run styles:build && npm run styles:postcss",
    "theme:build-local": "npm run get-browserlist && npm run theme:build",
    "get-browserlist": "cp ../psa.app.web/.browserslistrc ./"
  },
  "author": "",
  "license": "AGPL-3.0-or-later",
  "devDependencies": {
    "autoprefixer": "^10.4.13",
    "postcss": "^8.4.19",
    "postcss-cli": "^10.0.0",
    "sass": "^1.56.1"
  }
}
