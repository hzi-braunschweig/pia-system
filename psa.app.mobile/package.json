{
  "name": "app-mobile",
  "description": "PIA mobile app",
  "version": "1.43.0",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "prestart:browser": "npm run licenses",
    "start": "ng serve --port=4200 --poll 2000 --ssl true --configuration=development-web",
    "prebuild": "npm run licenses",
    "build": "ng build --configuration production",
    "build:develop": "ng build",
    "appflow:build": "npm run build",
    "preappflow:build": "cd ../psa.lib.licensecollector && npm ci",
    "prebuild:browser": "npm run licenses",
    "build:android": "ionic capacitor build android",
    "build:ios": "ionic capacitor build ios",
    "build:browser": "ng build --configuration production-web --base-href /",
    "start:android": "ionic capacitor run android",
    "start:ios": "ionic capacitor run ios",
    "open:android": "npx cap open android",
    "open:ios": "npx cap open ios",
    "sync": "npx cap sync",
    "serve": "ionic serve --configuration=development-web --port=4200",
    "test": "ng test",
    "test.unit": "ng test --no-watch --no-progress --browsers=ChromeHeadlessCI",
    "lint": "ng lint",
    "licenses": "licensecollector --format json --target ./src/assets/licenses.json --onlyProduction --assertValidLicenseTexts --excludePackages '@pia-system/charts@1.0.0'"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.2.5",
    "@angular/cdk": "^19.2.8",
    "@angular/common": "^19.2.5",
    "@angular/core": "^19.2.5",
    "@angular/forms": "^19.2.5",
    "@angular/platform-browser": "^19.2.5",
    "@angular/platform-browser-dynamic": "^19.2.5",
    "@angular/router": "^19.2.5",
    "@auth0/angular-jwt": "^5.2.0",
    "@awesome-cordova-plugins/in-app-browser": "~6.6.0",
    "@capacitor/android": "^7.4.4",
    "@capacitor/app": "^7.1.0",
    "@capacitor/app-launcher": "^7.0.2",
    "@capacitor/barcode-scanner": "^2.0.3",
    "@capacitor/camera": "^7.0.2",
    "@capacitor/core": "^7.4.4",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/keyboard": "^7.0.0",
    "@capacitor/network": "^7.0.0",
    "@capacitor/push-notifications": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "@capawesome-team/capacitor-file-opener": "^7.0.1",
    "@capawesome/capacitor-badge": "^7.0.1",
    "@ionic/angular": "^8.6.4",
    "@ngx-translate/core": "^15.0.0",
    "@ngx-translate/http-loader": "^8.0.0",
    "@pia-system/charts": "file:../psa.lib.charts/dist",
    "chart.js": "^4.4.2",
    "compare-versions": "^6.1.0",
    "date-fns": "^2.30.0",
    "html5-qrcode": "^2.3.8",
    "keycloak-angular": "^19.0.2",
    "keycloak-js": "^25.0.6",
    "ngx-markdown": "^19.1.1",
    "rxjs": "^7.8.1",
    "swiper": "^11.1.1",
    "tslib": "^2.6.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.6",
    "@angular-eslint/builder": "^18.0.0",
    "@angular-eslint/eslint-plugin": "^18.0.0",
    "@angular-eslint/eslint-plugin-template": "^18.0.0",
    "@angular-eslint/schematics": "^18.0.0",
    "@angular-eslint/template-parser": "^18.0.0",
    "@angular/cli": "^19.2.6",
    "@angular/compiler": "^19.2.5",
    "@angular/compiler-cli": "^19.2.5",
    "@angular/language-service": "^19.2.5",
    "@capacitor/cli": "^7.0.0",
    "@ionic/angular-toolkit": "^11.0.1",
    "@ionic/cli": "^7.2.0",
    "@ionic/cordova-builders": "^11.0.0",
    "@pia-system/licensecollector": "file:../psa.lib.licensecollector",
    "@types/jasmine": "^5.1.4",
    "@types/jasminewd2": "^2.0.13",
    "@types/karma-viewport": "^1.0.0",
    "@types/node": "^20.12.7",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "cordova-plugin-inappbrowser": "^6.0.0",
    "es6-promise-plugin": "^4.2.2",
    "eslint": "^8.57.0",
    "execa": "^8.0.1",
    "jasmine-core": "^5.1.2",
    "jasmine-spec-reporter": "^7.0.0",
    "karma": "^6.4.3",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "karma-junit-reporter": "^2.0.1",
    "karma-viewport": "^1.0.9",
    "ng-mocks": "^14.13.5",
    "ts-mockito": "^2.6.1",
    "ts-node": "10.9.2",
    "typescript": "~5.8.3"
  },
  "cordova": {
    "plugins": {
      "cordova-plugin-inappbrowser": {}
    },
    "platforms": [
      "ios",
      "android"
    ]
  }
}
